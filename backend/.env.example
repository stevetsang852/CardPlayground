# Server Configuration
PORT=3000
NODE_ENV=development

# Database: local (default, free JSON file) or firestore
DATABASE_DRIVER=local
LOCAL_DB_PATH=./data/local-db.json

# Auth
# true = skip auth verification (local debug only). Game APIs still attach a player id.
DEBUG_AUTH_BYPASS=true
DEBUG_PLAYER_ID=debug-player
AUTH_SECRET=cardplayground-local-dev-secret

# Firebase is optional. Only used when DATABASE_DRIVER=firestore
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# Redis is optional. Cache is skipped if Redis is down.
REDIS_URL=redis://localhost:6379

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
