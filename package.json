{
  "name": "card-mystery-realm",
  "version": "1.0.0",
  "description": "Card collection game with gacha mechanics, synthesis systems, and social features",
  "private": true,
  "workspaces": [
    "backend",
    "client",
    "shared"
  ],
  "scripts": {
